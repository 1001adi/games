# Auto detect text files and perform LF normalization
* text=auto
*.apk binary
*.zip binary
steel-front/*.zip filter=lfs diff=lfs merge=lfs -text
steel-front/*.apk filter=lfs diff=lfs merge=lfs -text
last-fortress/*.zip filter=lfs diff=lfs merge=lfs -text
falafel-allenby/*.zip filter=lfs diff=lfs merge=lfs -text
*.exe binary
steel-front/*.exe filter=lfs diff=lfs merge=lfs -text
abyss-depths/*.zip filter=lfs diff=lfs merge=lfs -text
abyss-depths/*.apk filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
